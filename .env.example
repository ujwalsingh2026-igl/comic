# Database Connection (PostgreSQL)
# For production: postgresql://postgres:password@localhost:5432/comic_prod
# If left as "embedded", uses in-process embedded PostgreSQL (PGlite) with full relational integrity
DATABASE_URL=embedded

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Security & Session Secrets (Generate with `openssl rand -hex 32`)
JWT_SECRET=replace_with_64_char_crypto_random_secret_in_production_32bytes_minimum
COOKIE_SECRET=replace_with_cookie_secret_minimum_32_characters_long_for_security

# Razorpay / Payment Gateway Credentials
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_public_key_example
RAZORPAY_KEY_SECRET=rzp_test_secret_example_never_expose_to_frontend
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_for_signature_verification

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=example-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=example-google-client-secret

# OTP & SMS Provider Configuration
# Set to 'true' in development to log test OTP in secure audit logs without sending billable SMS
OTP_MOCK_MODE=true
OTP_SERVICE_API_KEY=

# Object Storage & CDN
STORAGE_PROVIDER=local
STORAGE_BUCKET=comic-platform-media
CDN_URL=http://localhost:3000/media
